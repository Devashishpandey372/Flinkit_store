# ==============================================================================
# Flinkit Store Backend Environment Variables Template
# For Render Deployment & MongoDB Atlas Production Setup
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database Connection
# Local: mongodb://localhost:27017/flinkit-store
# MongoDB Atlas (Production):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/flinkit-store?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=generate_a_secure_random_64_character_hex_string_for_production
JWT_EXPIRES_IN=7d

# Cross-Domain Cookie Configuration
COOKIE_DOMAIN=
COOKIE_SECURE=true

# Razorpay Payment Gateway (Get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_TxmRkUb5lUsIDq
RAZORPAY_KEY_SECRET=qNfdyGDZEdbkHGpgw9Lvn81I
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Frontend URL (For CORS whitelist on Render)
# Set to your Vercel deployment URL (e.g. https://flinkit-store.vercel.app)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Initial Administrator Credentials (used by npm run seed:admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@flinkitstore.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=ChangeThisSecurePasswordInProduction@123

# Shopkeeper & Admin Security Invitation Codes
ADMIN_INVITE_CODE=FLINKIT_ADMIN_SECRET_2026
SHOPKEEPER_INVITE_CODE=FLINKIT_SHOP_2026
AUTO_APPROVE_SHOPKEEPER=false

# Serviceable PIN Codes (Comma-separated)
SERVICEABLE_PINCODES=110001,110002,400001,400002,500001,560001,600001,700001,380001,302001
